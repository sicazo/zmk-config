#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Sym         1
#define Game        2

/* =========================
   UNIFIED HOLD-TAP SETTINGS
   ========================= */

&mt {
    tapping-term-ms = <2000>;
    quick-tap-ms = <120>;
    flavor = "tap-preferred";
    global-quick-tap;
};

&lt {
    tapping-term-ms = <2000>;
    quick-tap-ms = <120>;
    flavor = "tap-preferred";
};

/ {
    combos { compatible = "zmk,combos"; };

    behaviors {
        ge: gui_esc {
            compatible = "zmk,behavior-hold-tap";
            label = "GUI_ESC";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <150>;
            bindings =
                <&kp>,
                <&kp>;
        };

        ct: ctrl_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "CTRL_TAP";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <150>;
            bindings =
                <&kp>,
                <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* =========================
           QWERTY LAYER
           ========================= */

        Qwerty {
            display-name = "Qwerty";
            bindings = <
                  &kp Q       &kp W       &kp E          &kp R         &kp T      &kp Y          &kp U         &kp I        &kp O       &kp P
                  &mt LGUI A  &mt LALT S  &mt LCTRL D    &mt LSHIFT F  &kp G      &kp H          &mt RSHIFT J  &mt RCTRL K  &mt RALT L  &mt RGUI SEMICOLON
&kp LEFT_SHIFT  &kp Z       &kp X       &kp C          &kp V         &kp B      &kp N          &kp M         &kp COMMA    &kp DOT     &kp SLASH   &tog 2
                                          &ct LCTRL LALT &ge LGUI ESC   &kp BACKSPACE &kp SPACE      &kp ENTER    &mo 1
            >;
        };

        /* =========================
           SYMBOL / NUMBER LAYER
           ========================= */

        Symbols {
            display-name = "Symbols";
            bindings = <
           &kp LEFT_BRACKET  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp GRAVE
           &kp DOLLAR        &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS          &kp LEFT        &kp DOWN         &kp UP                &kp RIGHT              &kp BACKSLASH
&trans    &kp NUMBER_0      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL          &kp UNDER       &kp SQT          &kp DQT              &kp PIPE               &kp EXCL         &trans
                                                    &kp LSHIFT     &kp LCTRL    &kp LALT           &kp RALT        &kp RCTRL        &kp RSHIFT
            >;
        };

        /* =========================
           GAME LAYER
           ========================= */

        Game {
            display-name = "Game";
            bindings = <
                  &kp TAB         &kp Z       &kp X       &kp C       &kp V      &trans      &trans      &trans      &trans      &trans
                  &kp LEFT_SHIFT  &kp Q       &kp W       &kp E       &kp R      &trans      &trans      &trans      &trans      &trans
&lt 1 LCTRL   &kp LCTRL      &kp A       &kp S       &kp D       &kp F      &trans      &trans      &trans      &trans      &trans      &tog 2
                                             &kp ESC     &kp LALT    &kp SPACE  &kp BACKSPACE  &kp ENTER  &mo 1
            >;
        };
    };
};
