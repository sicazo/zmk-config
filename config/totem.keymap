#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Sym         1
#define Game        2

/* =========================
   UNIFIED HOLD-TAP SETTINGS
   ========================= */

&mt {
    tapping-term-ms = <2000>;
    quick-tap-ms = <120>;
    flavor = "tap-preferred";
    global-quick-tap;
};

&lt {
    tapping-term-ms = <2000>;
    quick-tap-ms = <120>;
    flavor = "tap-preferred";
};

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        /* =========================
           QWERTY LAYER
           ========================= */

        Qwerty {
            display-name = "Qwerty";
            bindings = <
                &kp Q       &kp W       &kp E        &kp R         &kp T        &kp Y          &kp U         &kp I        &kp O       &kp P
                &mt LGUI A  &mt LALT S  &mt LCTRL D  &mt LSHIFT F  &kp G        &kp H          &mt RSHIFT J  &mt RCTRL K  &mt RALT L  &mt RGUI SEMICOLON
&kp LEFT_SHIFT  &kp Z       &kp X       &kp C        &kp V         &kp B        &kp N          &kp M         &kp COMMA    &kp DOT     &kp SLASH           &tog 2
                                        &kp ESC      &kp LGUI      &kp SPACE    &kp BACKSPACE  &kp ENTER     &mo 1
            >;
        };

        /* =========================
           SYMBOL / NUMBER LAYER
           ========================= */

        Symbols {
            display-name = "Symbols";
            bindings = <
        &kp LBKT       &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp RBKT     &kp LBRC   &kp RBRC   &kp LPAR      &kp RPAR  &kp GRAVE
        &kp SEMICOLON  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp EQUAL    &kp MINUS  &kp PLUS   &kp ASTERISK  &kp FSLH  &kp BSLH
&trans  &kp SQT        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp DOT      &kp COMMA  &kp LT     &kp GT        &kp EXCL  &kp PIPE   &trans
                                     &kp LSHIFT    &kp LCTRL     &kp LALT     &kp RALT   &kp RCTRL  &kp RSHIFT
            >;
        };

        /* =========================
           GAME LAYER
           ========================= */

        Game {
            display-name = "Game";
            bindings = <
             &kp TAB         &kp Z  &kp X    &kp C     &kp V        &trans         &trans     &trans  &trans  &trans
             &kp LEFT_SHIFT  &kp Q  &kp W    &kp E     &kp R        &trans         &trans     &trans  &trans  &trans
&lt 1 LCTRL  &kp LCTRL       &kp A  &kp S    &kp D     &kp F        &trans         &trans     &trans  &trans  &trans  &tog 2
                                    &kp ESC  &kp LALT  &kp SPACE    &kp BACKSPACE  &kp ENTER  &mo 1
            >;
        };
    };
};
